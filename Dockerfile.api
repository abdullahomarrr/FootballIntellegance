FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY data/coverage ./data/coverage
RUN uv sync --frozen --no-dev --group postgres
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
# Hosts such as Render inject PORT; fall back to 8000 locally.
CMD ["sh", "-c", "uvicorn football_intelligence.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
