POSTGRES_DB=football_intelligence
POSTGRES_USER=football
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+psycopg://football:replace-me@localhost:5432/football_intelligence
RAW_STORE_ROOT=./data/raw
API_FOOTBALL_KEY=


# Optional: let a small LLM extract research claims (claims are still grounded: each quote must
# appear verbatim in the fetched source text, otherwise the claim is dropped).
# Local, free, no key: any OpenAI-compatible server, e.g. Ollama.
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_MODEL=
RESEARCH_LLM_API_KEY=
# Or Anthropic's API (used only when RESEARCH_LLM_BASE_URL is empty):
ANTHROPIC_API_KEY=
# A real contact URL or email, sent in the User-Agent to Wikipedia as their policy asks.
RESEARCH_CONTACT=
RESEARCH_LLM_REASONING_EFFORT=none

# Optional: current La Liga stats tier (free tier of https://bigballsdata.com, current season only)
BIGBALLS_API_KEY=
